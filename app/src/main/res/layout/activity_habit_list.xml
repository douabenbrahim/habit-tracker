<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_habit_list.xml
    Écran principal après connexion.
    Affiche la liste des habitudes + boutons d'action.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- En-tête coloré -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A237E"
        android:padding="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">

        <!-- Message de bienvenue -->
        <TextView
            android:id="@+id/textBienvenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👋 Bonjour !"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💪 Mes Habitudes"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Barre de boutons d'action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#E8EAF6">

        <!-- Bouton Ajouter -->
        <Button
            android:id="@+id/boutonAjouter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="➕ Ajouter"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A237E"
            android:layout_marginEnd="6dp" />

        <!-- Bouton Stats -->
        <Button
            android:id="@+id/boutonStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Stats"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4527A0"
            android:layout_marginEnd="6dp" />

        <!-- Bouton Déconnecter -->
        <Button
            android:id="@+id/boutonDeconnecter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚪 Quitter"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C" />

    </LinearLayout>

    <!-- Message si liste vide -->
    <TextView
        android:id="@+id/textVide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="🎯\n\nAucune habitude pour l'instant.\n\nAppuyez sur ➕ Ajouter\npour commencer !"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        android:visibility="gone"
        android:padding="32dp" />

    <!-- Liste des habitudes -->
    <ListView
        android:id="@+id/listViewHabitudes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="8dp" />

</LinearLayout>
