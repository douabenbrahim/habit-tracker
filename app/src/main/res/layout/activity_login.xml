<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_login.xml
    Écran de connexion — affiché au premier lancement.
    Contient un formulaire username/password et un lien vers l'inscription.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Icône / Emoji de l'app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💪"
            android:textSize="72sp"
            android:gravity="center"
            android:layout_gravity="center" />

        <!-- Titre de l'app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HabitBreaker"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Sous-titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brisez vos mauvaises habitudes"
            android:textSize="15sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Carte de connexion -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Titre du formulaire -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connexion"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="20dp" />

                <!-- Label username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Nom d'utilisateur"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp" />

                <!-- Champ username -->
                <EditText
                    android:id="@+id/champUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Entrez votre nom d'utilisateur"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:background="@drawable/edittext_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Label mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Mot de passe"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp" />

                <!-- Champ mot de passe -->
                <EditText
                    android:id="@+id/champPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Entrez votre mot de passe"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:background="@drawable/edittext_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <!-- Message d'erreur (caché par défaut) -->
                <TextView
                    android:id="@+id/textErreur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:padding="8dp"
                    android:background="#FFEBEE" />

                <!-- Bouton Se connecter -->
                <Button
                    android:id="@+id/boutonConnecter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Se connecter"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1A237E"
                    android:layout_marginTop="8dp"
                    android:padding="14dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lien vers inscription -->
        <TextView
            android:id="@+id/lienInscription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pas encore de compte ? S'inscrire →"
            android:textColor="#1A237E"
            android:textSize="15sp"
            android:padding="12dp"
            android:textStyle="bold"
            android:layout_gravity="center" />

    </LinearLayout>
</ScrollView>
