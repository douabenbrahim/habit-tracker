<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_register.xml
    Écran d'inscription — créer un nouveau compte.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:paddingTop="50dp"
        android:paddingBottom="40dp">

        <!-- Emoji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟"
            android:textSize="64sp"
            android:gravity="center"
            android:layout_gravity="center" />

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer un compte"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rejoignez HabitBreaker !"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp" />

        <!-- Carte du formulaire -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Nom d'utilisateur"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/regChampUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Minimum 3 caractères"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:background="@drawable/edittext_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Mot de passe"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/regChampPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Minimum 4 caractères"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:background="@drawable/edittext_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Confirmer mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Confirmer le mot de passe"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/regChampConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Répétez le mot de passe"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:background="@drawable/edittext_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <!-- Message d'erreur (caché par défaut) -->
                <TextView
                    android:id="@+id/regTextErreur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:padding="8dp"
                    android:background="#FFEBEE" />

                <!-- Bouton S'inscrire -->
                <Button
                    android:id="@+id/regBoutonInscrire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Créer mon compte"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32"
                    android:layout_marginTop="8dp"
                    android:padding="14dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lien retour connexion -->
        <TextView
            android:id="@+id/regLienConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Déjà un compte ? Se connecter"
            android:textColor="#1A237E"
            android:textSize="15sp"
            android:padding="12dp"
            android:textStyle="bold"
            android:layout_gravity="center" />

    </LinearLayout>
</ScrollView>
